# 多模态数据检索平台：火山引擎配置模板，无真实凭证。
# 默认只读进程环境。需要 dotenv 时，在启动命令前显式设置：
# APP_ENV_FILE=/absolute/path/to/backend/.env
# 不覆盖现有 .env；控制台提供实际 endpoint、bucket、账号和证书。
DEBUG=false

TOS_ACCESS_KEY_ID=
TOS_ACCESS_KEY_SECRET=
TOS_SECURITY_TOKEN=
TOS_BUCKET_NAME=
TOS_ENDPOINT=
TOS_REGION=cn-beijing
TOS_CUSTOM_DOMAIN=
TOS_SIGNED_URL_EXPIRES=3600

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TAG_MODEL=doubao-seed-2-1-lite-260915
ARK_EMBEDDING_MODEL=doubao-embedding-vision-251215
ARK_REQUEST_TIMEOUT=300
ARK_MAX_RETRIES=2
ARK_RETRY_BASE_DELAY=1
ARK_RETRY_MAX_DELAY=30
ARK_MAX_CONCURRENCY=5

# 单条媒体一个稠密向量；修改空间身份必须使用新集合显式重建。
EMBEDDING_DIMENSION=1024
EMBEDDING_CORPUS_INSTRUCTION_VERSION=road-scene-corpus-v1
EMBEDDING_QUERY_INSTRUCTION_VERSION=road-scene-query-v1
TEXT_SEARCH_MIN_SCORE=0
MILVUS_COLLECTION=media_vectors_v2
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DB_NAME=default
# 本机 Compose 默认关闭鉴权且仅绑定回环地址。启用鉴权后，TOKEN 与
# USER/PASSWORD 二选一；不要把凭证写入 URI。
MILVUS_AUTH_ENABLED=false
MILVUS_TOKEN=
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_SECURE=false
MILVUS_CA_CERT=
MILVUS_SERVER_NAME=
MILVUS_TIMEOUT=30
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=HNSW
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_SEARCH_EF=100
MILVUS_CONSISTENCY_LEVEL=Strong

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=multimodal_platform
MYSQL_USER=multimodal_app
MYSQL_PASSWORD=
MYSQL_SSL_ENABLED=false
MYSQL_SSL_CA=
MYSQL_CONNECT_TIMEOUT=10

# 仅供 deploy/docker-compose.infrastructure.yml 使用，不由应用读取。
# 三个值都必须在目标服务器设置为互不相同的强随机值。
INFRA_MYSQL_ROOT_PASSWORD=
INFRA_MINIO_ROOT_USER=
INFRA_MINIO_ROOT_PASSWORD=

# 必须注入随机 JWT 密钥和强管理员密码；没有默认密码。
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOW_REGISTRATION=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=7200
CLOUD_IO_MAX_WORKERS=5

# 标注帧必须在发布包外的持久化磁盘上，禁止配置静态服务 alias/root。
# 由运维预建为应用账号独占（0700），升级、备份时保留；不是临时缓存。
ANNOTATION_STORAGE_DIR=/var/lib/multimodal-platform/annotations
# 独立工作目录，不与持久化帧目录相同或互为父子目录。
ANNOTATION_TEMP_DIR=/var/tmp/multimodal-platform/annotation-work
# R4 初始上限：2 GiB、30 分钟、8K 总像素，解码并发 1。
ANNOTATION_MAX_VIDEO_BYTES=2147483648
ANNOTATION_MAX_VIDEO_SECONDS=1800
ANNOTATION_MAX_FRAME_PIXELS=33177600
ANNOTATION_DECODE_CONCURRENCY=1
# 解码子进程预算，不替代 TASK_TIMEOUT / ARK_REQUEST_TIMEOUT。
ANNOTATION_DECODE_TIMEOUT=300
